<file path="orchestration/order-creation-state-machine.asl.json">
{
  "Comment": "Order Creation State Machine — validate cart, resolve address, create order, process payment",
  "StartAt": "ValidateCart",
  "States": {
    "ValidateCart": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:...:function:validate_order",
      "Next": "CartValidChoice"
    },
    "CartValidChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.valid",
          "BooleanEquals": true,
          "Next": "ResolveAddress"
        }
      ],
      "Default": "CartInvalidFail"
    },
    "ResolveAddress": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:...:function:resolve_delivery_address",
      "Comment": "FDS-25: create new address or verify existing one; output merged via ResultPath into $.delivery_address",
      "ResultPath": "$.delivery_address",
      "Next": "CreateOrderStep"
    },
    "CreateOrderStep": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:...:function:create_order_step",
      "Comment": "FDS-24: snapshot items, compute totals, persist order with PENDING_PAYMENT",
      "Next": "CreatePaymentSession"
    },
    "CreatePaymentSession": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:...:function:create_payment_session",
      "Comment": "FDS-27: create PayPal checkout order; input mapped from CreateOrderStep — amount maps from subtotal (delivery_fee=0 so total==subtotal today; switch to payable total once delivery_fee exists)",
      "Parameters": {
        "order_id.$": "$.order_id",
        "amount.$": "$.subtotal",
        "currency.$": "$.currency"
      },
      "ResultPath": "$.payment",
      "End": true,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PaymentSessionFailed"
        }
      ]
    },
    "PaymentSessionFailed": {
      "Type": "Fail",
      "Error": "PAYMENT_SESSION_FAILED",
      "Cause": "CreatePaymentSession step failed — check CloudWatch logs"
    },
    "CartInvalidFail": {
      "Type": "Fail",
      "Error": "CART_VALIDATION_FAILED",
      "Cause": "Menu Service rejected the cart"
    }
  }
}
</file>

<file path="src/lambdas/validate_order/handler.py">
"""Step Functions step - validate the customer's cart via Menu Service (FDS-21).

This is the first step of the order creation flow. On an invalid cart it
returns a structured result with ``valid = False`` so the state machine can
stop the flow via a Choice state, instead of letting an exception bubble up.
"""

from src.modules.orders.validation import cart_validation_service
from src.shared.errors.app_error import AppError


def handler(event, context=None):
    restaurant_id = event["restaurant_id"]
    items = event.get("items", [])

    # --- pass-through fields: downstream steps need these ---
    delivery_address = event.get("delivery_address")
    delivery_address_id = event.get("delivery_address_id")

    try:
        result = cart_validation_service.validate_cart(restaurant_id, items)
    except AppError as err:
        return {
            "order_id": event.get("order_id"),
            "customer_id": event.get("customer_id"),
            "restaurant_id": restaurant_id,
            "delivery_address": delivery_address,
            "delivery_address_id": delivery_address_id,
            "valid": False,
            "error": err.code,
            "message": err.message,
            "validated_items": [],
        }

    # Merge original quantities into the validated items so downstream steps
    # (e.g. CreateOrderStep) can compute line totals without re-fetching.
    # If a validated item has no matching cart entry (data inconsistency),
    # quantity defaults to 0 — the service will produce a line_total of 0.
    qty_by_id: dict[str, int] = {i["menu_item_id"]: int(i["quantity"]) for i in items}
    return {
        "order_id": event.get("order_id"),
        "customer_id": event.get("customer_id"),
        "restaurant_id": restaurant_id,
        "delivery_address": delivery_address,
        "delivery_address_id": delivery_address_id,
        "valid": result.valid,
        "validated_items": [
            {
                "menu_item_id": vi.menu_item_id,
                "name": vi.name,
                "unit_price": vi.unit_price,
                "quantity": qty_by_id.get(vi.menu_item_id, 0),
                "available": vi.available,
            }
            for vi in result.items
        ],
    }
</file>

<file path="src/modules/orders/api/mappers.py">
"""Map internal Order models to API response shapes (FDS-21, FDS-24).

Internal fields (status_history, cancel_reason) are stripped from the response.
currency is preserved (FDS-24).

Note: delivery_address fields (street, city, postal_code) may be null until
FDS-25 implements the full address join.
"""

from __future__ import annotations

from dataclasses import asdict

from src.modules.orders.model.order import Order


def to_order_response(order: Order) -> dict:
    """Serialize an Order (incl. delivery_address) to a response dict.

    Internal fields (status_history, cancel_reason) are stripped.
    currency is kept in the response (FDS-24).
    """
    data = asdict(order)
    data.pop("status_history", None)
    data.pop("cancel_reason", None)
    data["status"] = order.status.value
    data["total"] = order.subtotal
    return data
</file>

<file path=".github/workflows/deploy-step-functions.yml">
name: Deploy Step Functions

on:
  push:
    branches: [main, deploy]
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest

    permissions:
      id-token: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v6
        with:
          python-version: "3.12"

      - name: Validate ASL
        run: |
          set -euo pipefail
          python -c "import json; json.load(open('orchestration/order-creation-state-machine.asl.json'))"
          python -c "import json; json.load(open('orchestration/payment-confirmation-state-machine.asl.json'))"
          echo "Both ASLs are valid JSON"

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Package Lambdas
        run: |
          set -euo pipefail
          python scripts/package_lambdas.py

      - name: Deploy Lambdas
        id: deploy-lambdas
        run: |
          set -euo pipefail

          DEPLOYABLE=("validate_order" "resolve_delivery_address" "create_order_step" "create_payment_session" "paypal_webhook" "verify_payment" "mark_payment_result" "publish_order_event")
          ROLE_ARN="${{ secrets.LAMBDA_EXECUTION_ROLE_ARN }}"

          # Init summary file for created-vs-updated tracking
          SUMMARY_FILE="deploy-summary.txt"

          for func in "${DEPLOYABLE[@]}"; do
            echo "::group::Deploying ${func}"

            ZIP_FILE="build/${func}.zip"

            if aws lambda get-function --function-name "${func}" --no-cli-pager &>/dev/null; then
              echo "  Updating existing function: ${func}"
              aws lambda update-function-code \
                --function-name "${func}" \
                --zip-file "fileb://${ZIP_FILE}" \
                --no-cli-pager
              aws lambda wait function-updated-v2 --function-name "${func}" --no-cli-pager
              ACTION="updated"
            else
              echo "  Creating new function: ${func}"
              aws lambda create-function \
                --function-name "${func}" \
                --runtime python3.12 \
                --timeout 30 \
                --memory-size 256 \
                --role "${ROLE_ARN}" \
                --handler "src.lambdas.${func}.handler.handler" \
                --zip-file "fileb://${ZIP_FILE}" \
                --no-cli-pager
              aws lambda wait function-active-v2 --function-name "${func}" --no-cli-pager
              ACTION="created"
            fi

            # Merge SERVICE_SECRET_ARN into existing env vars.
            # get-function-configuration returns "null" when there are no env vars;
            # coerce that to {} before merging.
            EXISTING_VARS=$(aws lambda get-function-configuration \
              --function-name "${func}" \
              --query 'Environment.Variables' \
              --output json \
              --no-cli-pager 2>/dev/null || echo "{}")
            MERGED_VARS=$(echo "${EXISTING_VARS}" | jq -c \
              --arg arn "${{ secrets.SERVICE_SECRET_ARN }}" \
              '(. // {}) + {SERVICE_SECRET_ARN: $arn}')

            # Per-function extra env vars (merged on top, never overwrites SERVICE_SECRET_ARN).
            EXTRA_VARS="{}"
            if [ "${func}" = "publish_order_event" ]; then
              EXTRA_VARS='{"EVENT_BUS_NAME": "food-delivery-orders"}'
            elif [ "${func}" = "paypal_webhook" ]; then
              EXTRA_VARS=$(echo '{}' | jq -c \
                --arg sm_arn "${{ secrets.PAYMENT_CONFIRMATION_SM_ARN }}" \
                '. + {PAYMENT_CONFIRMATION_SM_ARN: $sm_arn}')
            fi
            MERGED_VARS=$(echo "${MERGED_VARS}" | jq -c --argjson extra "${EXTRA_VARS}" '. + $extra')

            aws lambda update-function-configuration \
              --function-name "${func}" \
              --environment "{\"Variables\": ${MERGED_VARS}}" \
              --no-cli-pager

            echo "${func}: ${ACTION}" >> "${SUMMARY_FILE}"
            echo "::endgroup::"
          done

          echo "summary_file=${SUMMARY_FILE}" >> "${GITHUB_OUTPUT}"

      - name: Render ASL and deploy State Machine
        id: deploy-sm
        run: |
          set -euo pipefail

          # Resolve actual Lambda ARNs from deployed functions
          VALIDATE_ARN=$(aws lambda get-function --function-name validate_order \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)
          RESOLVE_ARN=$(aws lambda get-function --function-name resolve_delivery_address \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)
          CREATE_ARN=$(aws lambda get-function --function-name create_order_step \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)
          PAYMENT_SESSION_ARN=$(aws lambda get-function --function-name create_payment_session \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)

          echo "Resolved Lambda ARNs:"
          echo "  validate_order:             ${VALIDATE_ARN}"
          echo "  resolve_delivery_address:   ${RESOLVE_ARN}"
          echo "  create_order_step:          ${CREATE_ARN}"
          echo "  create_payment_session:     ${PAYMENT_SESSION_ARN}"

          # Substitute placeholder ARNs with real ARNs via jq walk
          jq --arg validate_arn "${VALIDATE_ARN}" \
             --arg resolve_arn "${RESOLVE_ARN}" \
             --arg create_arn "${CREATE_ARN}" \
             --arg payment_session_arn "${PAYMENT_SESSION_ARN}" \
             'walk(
               if type == "string" and contains("function:validate_order") then $validate_arn
               elif type == "string" and contains("function:resolve_delivery_address") then $resolve_arn
               elif type == "string" and contains("function:create_payment_session") then $payment_session_arn
               elif type == "string" and contains("function:create_order_step") then $create_arn
               else . end
             )' \
             orchestration/order-creation-state-machine.asl.json > rendered.asl.json

          echo "Rendered ASL written to rendered.asl.json"

          SM_NAME="${{ secrets.AWS_STEP_FUNCTIONS_STATE_MACHINE_NAME }}"

          # Look up existing state machine by name
          SM_ARN=$(aws stepfunctions list-state-machines \
            --query "stateMachines[?name=='${SM_NAME}'].stateMachineArn" \
            --output text --no-cli-pager)

          if [ -n "${SM_ARN}" ] && [ "${SM_ARN}" != "None" ]; then
            echo "Updating existing state machine: ${SM_NAME} (${SM_ARN})"
            aws stepfunctions update-state-machine \
              --state-machine-arn "${SM_ARN}" \
              --definition "$(cat rendered.asl.json)" \
              --role-arn "${{ secrets.AWS_STEP_FUNCTIONS_ROLE_ARN }}" \
              --no-cli-pager
            SM_ACTION="updated"
          else
            echo "Creating new state machine: ${SM_NAME}"
            aws stepfunctions create-state-machine \
              --name "${SM_NAME}" \
              --definition "$(cat rendered.asl.json)" \
              --role-arn "${{ secrets.AWS_STEP_FUNCTIONS_ROLE_ARN }}" \
              --no-cli-pager
            SM_ACTION="created"
          fi

          echo "sm_action=${SM_ACTION}" >> "${GITHUB_OUTPUT}"

      - name: Render + deploy Payment Confirmation SM
        id: deploy-payment-sm
        run: |
          set -euo pipefail

          # Resolve actual Lambda ARNs from deployed functions
          VERIFY_PAYMENT_ARN=$(aws lambda get-function --function-name verify_payment \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)
          MARK_PAYMENT_ARN=$(aws lambda get-function --function-name mark_payment_result \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)
          PUBLISH_ORDER_ARN=$(aws lambda get-function --function-name publish_order_event \
            --query 'Configuration.FunctionArn' --output text --no-cli-pager)

          echo "Resolved Lambda ARNs:"
          echo "  verify_payment:       ${VERIFY_PAYMENT_ARN}"
          echo "  mark_payment_result:  ${MARK_PAYMENT_ARN}"
          echo "  publish_order_event:  ${PUBLISH_ORDER_ARN}"

          # Substitute placeholder ARNs with real ARNs via jq walk
          jq --arg verify_arn "${VERIFY_PAYMENT_ARN}" \
             --arg mark_arn "${MARK_PAYMENT_ARN}" \
             --arg publish_arn "${PUBLISH_ORDER_ARN}" \
             'walk(
               if type == "string" and contains("function:verify_payment") then $verify_arn
               elif type == "string" and contains("function:mark_payment_result") then $mark_arn
               elif type == "string" and contains("function:publish_order_event") then $publish_arn
               else . end
             )' \
             orchestration/payment-confirmation-state-machine.asl.json > rendered-payment.asl.json

          echo "Rendered payment ASL written to rendered-payment.asl.json"

          SM_NAME="${{ secrets.AWS_PAYMENT_SM_NAME }}"

          # Look up existing state machine by name
          SM_ARN=$(aws stepfunctions list-state-machines \
            --query "stateMachines[?name=='${SM_NAME}'].stateMachineArn" \
            --output text --no-cli-pager)

          if [ -n "${SM_ARN}" ] && [ "${SM_ARN}" != "None" ]; then
            echo "Updating existing state machine: ${SM_NAME} (${SM_ARN})"
            aws stepfunctions update-state-machine \
              --state-machine-arn "${SM_ARN}" \
              --definition "$(cat rendered-payment.asl.json)" \
              --role-arn "${{ secrets.AWS_STEP_FUNCTIONS_ROLE_ARN }}" \
              --no-cli-pager
            PAYMENT_SM_ACTION="updated"
          else
            echo "Creating new state machine: ${SM_NAME}"
            aws stepfunctions create-state-machine \
              --name "${SM_NAME}" \
              --definition "$(cat rendered-payment.asl.json)" \
              --role-arn "${{ secrets.AWS_STEP_FUNCTIONS_ROLE_ARN }}" \
              --no-cli-pager
            PAYMENT_SM_ACTION="created"
          fi

          echo "payment_sm_action=${PAYMENT_SM_ACTION}" >> "${GITHUB_OUTPUT}"
          echo "payment_sm_name=${SM_NAME}" >> "${GITHUB_OUTPUT}"

      - name: Deployment Summary
        if: always()
        run: |
          set -euo pipefail

          SM_NAME="${{ secrets.AWS_STEP_FUNCTIONS_STATE_MACHINE_NAME }}"
          PAYMENT_SM_NAME="${{ secrets.AWS_PAYMENT_SM_NAME }}"
          REGION="${{ secrets.AWS_REGION }}"
          SUMMARY_FILE="${{ steps.deploy-lambdas.outputs.summary_file }}"
          SM_ACTION="${{ steps.deploy-sm.outputs.sm_action }}"
          PAYMENT_SM_ACTION="${{ steps.deploy-payment-sm.outputs.payment_sm_action }}"

          {
            echo "## 🚀 Step Functions Deployment Summary"
            echo ""
            echo "| Resource | Action |"
            echo "|----------|--------|"
            echo "| State Machine \`${SM_NAME}\` | ${SM_ACTION:-deployed} |"
            echo "| Payment SM \`${PAYMENT_SM_NAME}\` | ${PAYMENT_SM_ACTION:-deployed} |"
            echo "| Region | \`${REGION}\` |"
            if [ -f "${SUMMARY_FILE:-}" ]; then
              while IFS=: read -r name action; do
                echo "| Lambda \`${name}\` | ${action} |"
              done < "${SUMMARY_FILE}"
            else
              echo "| Lambda \`validate_order\` | deployed |"
              echo "| Lambda \`resolve_delivery_address\` | deployed |"
              echo "| Lambda \`create_order_step\` | deployed |"
            fi
          } >> "${GITHUB_STEP_SUMMARY}"
